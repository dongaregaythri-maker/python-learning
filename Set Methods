# Set methods are built-in operations used to add, remove, copy, and compare elements in a set.

# 1. add() — Add one element

numbers = {10, 20, 30}
numbers.add(40)
print(numbers)

# {10, 20, 30, 40}

# update() — Add multiple elements

numbers = {10, 20}
numbers.update([30, 40, 50])
print(numbers)

# {10, 20, 30, 40, 50}

# remove() — Remove an element

numbers = {10, 20, 30, 40}
numbers.remove(20)
print(numbers)

# {10, 30, 40}

# discard() — Remove an element safely

numbers = {10, 20, 30}
numbers.discard(50)
print(numbers)

# {10, 20, 30}

# Reason: discard() does nothing if the element is absent; it does not raise an error.

# pop() — Remove and return an element

numbers = {10, 20, 30}
x = numbers.pop()
print(x)
print(numbers)

# 10
# {20, 30}

# clear() — Remove all elements

numbers = {10, 20, 30}
numbers.clear()
print(numbers)

# set()

# Reason: clear() removes every element from the set.

# copy() — Copy a set

numbers = {10, 20, 30}
new_numbers = numbers.copy()
print(new_numbers)

# {10, 20, 30}

# Set methods for comparing sets

a = {1, 2, 3, 4}
b = {3, 4, 5, 6}

# union()
# Combines all unique elements from both sets.
print(a.union(b))
# Output: {1, 2, 3, 4, 5, 6}

# intersection()
# Returns only common elements.

print(a.intersection(b))
# Output: {3, 4}

# difference()
# Returns elements in a that are not in b.

print(a.difference(b))
# Output: {1, 2}

# symmetric_difference()
# Returns elements in either set, but not both.

print(a.symmetric_difference(b))
# Output: {1, 2, 5, 6}

